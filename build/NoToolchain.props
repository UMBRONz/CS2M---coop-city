<Project>
  <!--
    Used when the official CS2 modding toolchain is not installed (CSII_TOOLPATH unset).
    References the game's own DLLs straight from the install and deploys to the game's local mods
    folder. The install is found via Steam's uninstall registry entry; override with the
    CS2GameDir environment variable.

    Local mods folder: <user data>\.cache\Mods\local\<ModName>.
    Game 1.6 loads every code mod, local ones included, through the Paradox SDK playset system:
    the SDK lists each sub-folder of its "local" source (.cache\Mods\mod_directory.json) as a local
    mod whose id is the folder name (PDX.SDK ModsCache.ListAllAvailableMods), and the game loads only
    mods enabled in the ACTIVE playset (Colossal.PSI.PdxSdk GetModsInActivePlayset). The old
    <user data>\Mods folder is no longer read, although the toolchain installer still points
    CSII_LOCALMODSPATH there. So after deploying: pick a playset and enable CS2M in it.
  -->
  <PropertyGroup>
    <CS2GameDir Condition="'$(CS2GameDir)' == ''">$([MSBuild]::GetRegistryValueFromView('HKEY_LOCAL_MACHINE\SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\Steam App 949230', 'InstallLocation', null, RegistryView.Registry64, RegistryView.Registry32))</CS2GameDir>
    <CS2ManagedDir>$(CS2GameDir)\Cities2_Data\Managed</CS2ManagedDir>
    <CSII_USERDATAPATH Condition="'$(CSII_USERDATAPATH)' == ''">$(USERPROFILE)\AppData\LocalLow\Colossal Order\Cities Skylines II</CSII_USERDATAPATH>
    <AssemblySearchPaths>$(CS2ManagedDir);$(AssemblySearchPaths)</AssemblySearchPaths>
    <!-- Deliberately not taken from the CSII_LOCALMODSPATH environment variable (stale, see above). -->
    <CS2LocalModsPath Condition="'$(CS2LocalModsPath)' == ''">$(CSII_USERDATAPATH)\.cache\Mods\local</CS2LocalModsPath>
    <CSII_LOCALMODSPATH>$(CS2LocalModsPath)</CSII_LOCALMODSPATH>
    <DeployDir>$(CSII_LOCALMODSPATH)\$(MSBuildProjectName)</DeployDir>
    <NeedBuild>true</NeedBuild>
    <!-- The game DLLs target Unity's netstandard 2.1; they load fine in the game's Mono. -->
    <NoWarn>$(NoWarn);MSB3270;MSB3277;MSB3268</NoWarn>
  </PropertyGroup>
</Project>
